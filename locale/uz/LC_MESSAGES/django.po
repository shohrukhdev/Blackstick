#: templates/landing/index.html:1240
msgid "Flyers & brochures"
msgstr "Flyerlar va broshyuralar"

#: templates/landing/index.html:1245
msgid "Individual staff links too."
msgstr "Har bir xodim uchun ham alohida havola."

#: templates/landing/index.html:1246
msgid ""
"Each staff member gets their own personal booking link, so clients can go "
